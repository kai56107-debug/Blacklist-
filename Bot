@bot.tree.command(name="check", description="Durchsucht alle Fraktions-Blacklists gleichzeitig (mit Notiz & Fuzzy-Suche).")
@app_commands.describe(name="Der zu prüfende Name oder Teilname")
async def slash_check(interaction: discord.Interaction, name: str):
    if config.get("lockdown", False):
        await trigger_silent_alarm(interaction, "check")
        await interaction.response.send_message("🔒 **System Lockdown:** Alle Abfragen sind gesperrt.", ephemeral=True)
        return

    if not get_user_factions(interaction.user) and interaction.user.id != OWNER_ID:
        await interaction.response.send_message("❌ Nur für Fraktions-Admins und den Owner.", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)
    check_target = name.strip().lower()

    if "canary" in check_target or "honeypot" in check_target:
        config["lockdown"] = True
        await save_config()
        await update_bound_messages()
        await log_system(f"🚨 **HONEYPOT AUSGELÖST!** Admin {interaction.user.mention} hat das Canary-Token abgefragt! Bot im automatischen Lockdown.", level="ERROR")
        await interaction.followup.send("❌ Ungültiger Suchbegriff.", ephemeral=True)
        return

    found_results = []
    all_names_for_fuzzy = []

    for faction, entries in blacklists.items():
        for entry in entries:
            if "canary" in entry.get("name", "").lower():
                continue
            m_name = entry.get("name", "")
            all_names_for_fuzzy.append(m_name)
            aliases = [a.lower() for a in entry.get("aliases", [])]
            note = entry.get("note")
            
            if check_target == m_name.lower() or check_target in aliases or check_target in m_name.lower():
                found_results.append((faction.upper(), m_name, note))

    if not found_results:
        close_matches = get_close_matches(name, all_names_for_fuzzy, n=3, cutoff=0.6)
        desc = "Der Begriff wurde in keiner Liste gefunden."
        if close_matches:
            desc += f"\n\n🔍 **Meintest du vielleicht:**\n• " + "\n• ".join(close_matches)
        embed = discord.Embed(title="✅ Kein direkter Treffer", description=desc, color=BRIGHT_GREEN)
    else:
        desc = ""
        for fac, m_name, note in found_results:
            desc += f"• **Fraktion:** `{fac}`\n  └ **Name:** `{m_name}`\n"
            if note:
                desc += f"  └ 📝 **Notiz:** `{note}`\n"
            desc += "\n"
        embed = discord.Embed(title="<:7990blacklistedids:1546843988328316928> TREFFER: Spieler gelistet!", description=desc, color=DARK_RED)

    await interaction.followup.send(embed=embed, ephemeral=True)

