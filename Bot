class PublicBlacklistExpandView(discord.ui.View):
    def __init__(self, faction: str):
        super().__init__(timeout=None)
        self.faction = faction

    @discord.ui.button(label="📂 Blacklist anzeigen (30 Sec. offen)", style=discord.ButtonStyle.primary, custom_id="public_expand_blacklist_btn")
    async def expand_blacklist(self, interaction: discord.Interaction, button: discord.ui.Button):
        if config.get("lockdown", False):
            await trigger_silent_alarm(interaction, "public_expand_list")
            await interaction.response.send_message("🔒 **SYSTEM IM LOCKDOWN:** Die Einsicht ist gesperrt.", ephemeral=True)
            return

        await interaction.response.defer()

        user_id = interaction.user.id
        user_expand_counts[user_id] = user_expand_counts.get(user_id, 0) + 1
        click_count = user_expand_counts[user_id]

        entries = blacklists.get(self.faction, [])
        ch_name = getattr(interaction.channel, "name", "Öffentlicher Kanal")
        
        is_owner = (user_id == OWNER_ID)
        source_info = f"Kanal-Klick in #{ch_name} von @{interaction.user.name} (ID: {user_id})" + (" [OWNER KOPIE]" if is_owner else "")
        
        embeds = format_blacklist_embeds(self.faction, entries, show_notes=False, source_info=source_info, is_owner_copy=is_owner)
        active_view = PublicBlacklistActiveView(self.faction, interaction.message.id)
        
        await interaction.message.edit(embed=embeds[0], view=active_view)

        log_msg = (
            f"👁️ **Öffentliche Blacklist aufgeklappt!**\n"
            f"• **Nutzer:** {interaction.user.mention} (`{interaction.user.name}` | ID: `{user_id}`)\n"
            f"• **Fraktion:** `{self.faction.upper()}` in {interaction.channel.mention}\n"
            f"• **Modus:** {'👑 Owner-Kopie (Sauber)' if is_owner else '🛡️ Gesichert mit Wasserzeichen'}\n"
            f"• **Häufigkeit:** Hat die Liste bisher **{click_count}x** aufgeklappt.\n"
            f"• **Zeitfenster:** 30 Sekunden"
        )
        await log_system(log_msg, level="WARNING" if click_count >= 5 else "INFO")

class PublicBlacklistActiveView(discord.ui.View):
