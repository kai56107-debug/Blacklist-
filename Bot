@bot.event
async def on_ready():
    load_data()
    if not dead_mans_snitch_loop.is_running():
        dead_mans_snitch_loop.start()
    if not daily_backup_task.is_running():
        daily_backup_task.start()
    if not system_health_check.is_running():
        system_health_check.start()

    try:
        for guild in bot.guilds:
            bot.tree.clear_commands(guild=guild)
            await bot.tree.sync(guild=guild)
        logger.info("🧹 Alte Server-Befehle gelöscht.")

        synced = await bot.tree.sync()
        logger.info(f"🌐 Globale Befehle erfolgreich synchronisiert: {len(synced)} Befehle.")
    except Exception as e:
        logger.error(f"Fehler beim Sync: {e}")

    await log_system(f"🚀 **Bot Online:** Erfolgreich gestartet als `{bot.user.name}`.")
    print(f"=== {bot.user.name} IST ONLINE UND BEREIT ===")

