async def log_system(message: str, level: str = "INFO"):
    if level == "ERROR":
        logger.error(message)
        color = discord.Color.red()
        title = "🔴 System Fehler"
    elif level == "WARNING":
        logger.warning(message)
        color = discord.Color.gold()
        title = "⚠️ System Warnung"
    else:
        logger.info(message)
        color = discord.Color.blue()
        title = "ℹ️ System Information"

    channel_id = config.get("system_log_channel")
    if channel_id:
        channel = bot.get_channel(channel_id)
        if channel:
            try:
                await channel.send(embed=discord.Embed(title=title, description=message, color=color, timestamp=datetime.now()))
            except Exception as e:
                logger.error(f"Fehler beim Senden des System-Logs: {e}")

