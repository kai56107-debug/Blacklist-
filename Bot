    embed = discord.Embed(title="🛡️ 4-Augen-Prinzip: Lösch-Anfrage", description=f"Admin {interaction.user.mention} möchte **{entry_to_remove.get('name')}** aus `{faction.upper()}` löschen.\n\n*Ein zweiter Admin muss zustimmen!*", color=discord.Color.gold())
    try:
        await ch.send(embed=embed, view=view)
    except Exception:
        pass

    await interaction.followup.send("✅ Lösch-Anfrage wurde in den Admin-Log gesendet (wartet auf 2. Admin).", ephemeral=True)

