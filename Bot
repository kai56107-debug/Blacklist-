def load_data():
    global blacklists, config, keywords, watermark_database
    
    old_legacy_file = "blacklist.json"
    medic_file = FILES["medic"]
    if os.path.exists(old_legacy_file) and not os.path.exists(medic_file):
        try:
            os.rename(old_legacy_file, medic_file)
            logger.info(f"Alte '{old_legacy_file}' umbenannt in '{medic_file}'!")
        except Exception as e:
            logger.error(f"Fehler beim Umbenennen von {old_legacy_file}: {e}")

    for faction, filename in FILES.items():
        if os.path.exists(filename):
            try:
                with open(filename, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    normalized = []
                    for entry in data:
                        if isinstance(entry, str):
                            normalized.append({"name": entry, "aliases": [], "note": None})
                        elif isinstance(entry, dict):
                            if "canary" not in entry.get("name", "").lower():
                                normalized.append(entry)
                    
                    canary_name = f"[CANARY_TRAP_{faction.upper()}]"
                    if not any(entry.get("name") == canary_name for entry in normalized):
                        normalized.append({"name": canary_name, "aliases": ["honeypot_token"], "note": "Sicherheitstoken - Nicht löschen!"})
                        
                    blacklists[faction] = normalized
            except Exception as e:
                logger.error(f"Fehler beim Laden von {filename}: {e}")
                blacklists[faction] = []
        else:
            canary_name = f"[CANARY_TRAP_{faction.upper()}]"
            blacklists[faction] = [{"name": canary_name, "aliases": ["honeypot_token"], "note": "Sicherheitstoken"}]

    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                loaded_cfg = json.load(f)
                config.update(loaded_cfg)
                if "action_log_channels" not in config or not isinstance(config["action_log_channels"], dict):
                    config["action_log_channels"] = {"medic": None, "army": None, "pd": None, "all": None}
                else:
                    if "all" not in config["action_log_channels"]:
                        config["action_log_channels"]["all"] = None
                if "lockdown" not in config:
                    config["lockdown"] = False
                if "last_action" not in config:
                    config["last_action"] = "Keine Aktionen seit Neustart"
                if "last_action_timestamp" not in config:
                    config["last_action_timestamp"] = None
        except Exception as e:
            logger.error(f"Fehler beim Laden von {CONFIG_FILE}: {e}")
    
    if os.path.exists(KEYWORDS_FILE):
        try:
            with open(KEYWORDS_FILE, "r", encoding="utf-8") as f:
                keywords = json.load(f)
        except Exception as e:
            logger.error(f"Fehler beim Laden von {KEYWORDS_FILE}: {e}")
            keywords = ["ban", "banned", "blacklist", "blacklisted", "cheater", "scammer"]
    else:
        keywords = ["ban", "banned", "blacklist", "blacklisted", "cheater", "scammer"]

    if os.path.exists(WATERMARK_FILE):
        try:
            with open(WATERMARK_FILE, "r", encoding="utf-8") as f:
                watermark_database = json.load(f)
        except Exception as e:
            logger.error(f"Fehler beim Laden von {WATERMARK_FILE}: {e}")
            watermark_database = {}

