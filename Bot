class RemoveApprovalView(discord.ui.View):
    def __init__(self, request_id: str, faction: str, entry: dict, user_id: int):
        super().__init__(timeout=86400)
        self.request_id = request_id
        self.faction = faction
        self.entry = entry
        self.user_id = user_id

    @discord.ui.button(label="✅ Freigeben (4-Augen-Prinzip)", style=discord.ButtonStyle.success)
    async def approve(self, interaction: discord.Interaction, button: discord.ui.Button):
        if interaction.user.id == self.user_id and interaction.user.id != OWNER_ID:
            await interaction.response.send_message("❌ Ein anderer Admin muss die Löschung freigeben!", ephemeral=True)
            return
        if not check_faction_permission(interaction.user, self.faction):
            await interaction.response.send_message("❌ Keine Rechte für diese Fraktion.", ephemeral=True)
            return

        entries = blacklists[self.faction]
        entries[:] = [e for e in entries if e.get("name", "").lower() != self.entry.get("name", "").lower()]
        await save_data(self.faction)
        await log_to_history(self.faction, self.entry, str(interaction.user))
        await update_bound_messages(self.faction)

        await interaction.response.edit_message(content=f"✅ **{self.entry.get('name')}** wurde von **{interaction.user.display_name}** freigegeben und gelöscht.", view=None)

    @discord.ui.button(label="❌ Ablehnen", style=discord.ButtonStyle.danger)
    async def deny(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not check_faction_permission(interaction.user, self.faction):
            await interaction.response.send_message("❌ Keine Rechte.", ephemeral=True)
            return
        await interaction.response.edit_message(content=f"❌ Lösch-Anfrage abgelehnt von {interaction.user.mention}.", view=None)

