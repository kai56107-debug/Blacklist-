    for item in list(config["bound_messages"]):
        channel_id = item.get("channel_id")
        f_type = item.get("faction")
        
        if not f_type:
            continue
            
        if faction and f_type != faction:
            clean_bound_list.append(item.copy())
            continue

        channel = bot.get_channel(channel_id)
