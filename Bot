async def send_history_paginated(interaction: discord.Interaction, faction: str, edit: bool = False):
    history_file = os.path.join(HISTORY_DIR, f"history_{faction}.json")
    if not os.path.exists(history_file):
        msg = f"📁 Archiv für **{faction.upper()}** ist leer."
        if edit:
            await interaction.response.edit_message(content=msg, embed=None, view=None)
        else:
            await interaction.followup.send(msg, ephemeral=True)
        return
        
    try:
        with open(history_file, "r", encoding="utf-8") as f:
            history_data = json.load(f)
    except Exception as e:
        msg = f"❌ Fehler beim Lesen: `{e}`"
        if edit:
            await interaction.response.edit_message(content=msg, embed=None, view=None)
        else:
            await interaction.followup.send(msg, ephemeral=True)
        return
        
    if not history_data:
        msg = f"📁 Archiv für **{faction.upper()}** ist leer."
        if edit:
            await interaction.response.edit_message(content=msg, embed=None, view=None)
        else:
            await interaction.followup.send(msg, ephemeral=True)
        return

    paginator = HistoryPaginatorView(history_data[::-1], faction)
    embed = paginator.build_embed()
    if edit:
        await interaction.response.edit_message(content=None, embed=embed, view=paginator)
