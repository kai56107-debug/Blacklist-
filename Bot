def get_user_factions(user: discord.Member) -> list:
    if user.id == OWNER_ID:
        return ["medic", "army", "pd"]
    allowed = []
    faction_admins = config.get("faction_admins", {})
    for faction, admins in faction_admins.items():
        if user.id in admins or (hasattr(user, "roles") and any(role.id in admins for role in user.roles)):
            allowed.append(faction)
    return allowed

def check_faction_permission(user: discord.Member, faction: str) -> bool:
    if user.id == OWNER_ID:
        return True
    faction_admins = config.get("faction_admins", {}).get(faction, [])
    if user.id in faction_admins:
        return True
    if hasattr(user, "roles") and any(role.id in faction_admins for role in user.roles):
        return True
    return False

def validate_and_clean_name(raw_input: str):
    cleaned = raw_input.strip()
    extracted_notes = []

    if not re.search(r'[a-zA-Z0-9ÄÖÜäöüß]', cleaned):
        return None, None, "Der eingegebene Name enthält keine gültigen Buchstaben/Zahlen."

    cleaned = re.sub(r'^[•\-\*\s]+', '', cleaned)
    
    bracket_matches = re.findall(r'[\(\[\{](.*?)[\)\]\}]', cleaned)
    if bracket_matches:
        extracted_notes.extend(bracket_matches)
        cleaned = re.sub(r'[\(\[\{].*?[\)\]\}]', '', cleaned)

    split_parts = re.split(r'\s*[-:\–\—]\s*', cleaned, maxsplit=1)
    if len(split_parts) > 1:
        cleaned = split_parts[0]
        if split_parts[1].strip():
            extracted_notes.append(split_parts[1].strip())

    words = cleaned.split()
    remaining_words = []
    
    for word in words:
        if any(word.lower() == kw.lower() for kw in keywords):
            extracted_notes.append(word)
        else:
            remaining_words.append(word)

    cleaned = " ".join(remaining_words).strip()
    words = cleaned.split()

    if not words:
        return None, None, "Der eingegebene Name ist ungültig oder leer."
    
    if len(words) == 1 and len(words[0]) < 2:
        return None, None, "Ungültiger Name! Zu kurz."

    if len(words) > 2:
        clean_name = f"{words[0]} {words[1]}"
        rest_note = " ".join(words[2:])
        extracted_notes.append(rest_note)
    else:
        clean_name = " ".join(words)

    note_str = ", ".join(extracted_notes) if extracted_notes else None
    return clean_name, note_str, None

def format_blacklist_embeds(faction: str, entries_list, show_notes: bool = False, source_info: str = "Öffentlicher Kanal", is_owner_copy: bool = False):
    safe_faction = (faction or "UNKNOWN").lower()
    faction_names = {
        "medic": "Mediziner Lomita Blacklist",
        "army": "Army Blacklist",
        "pd": "PD Blacklist"
    }
    title_name = faction_names.get(safe_faction, "Blacklist")

    is_locked = config.get("lockdown", False)
    real_entries = [e for e in entries_list if "canary" not in e.get("name", "").lower()]

    watermark_id = int(time.time()) % 100000
    w_key = str(watermark_id)
    
    watermark_database[w_key] = {
        "faction": safe_faction.upper(),
        "source": source_info,
        "created_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "entries_count": len(real_entries)
    }
    asyncio.create_task(save_watermarks())

    if not real_entries:
        embed = discord.Embed(
            title=f"<:7990blacklistedids:1546843988328316928> {title_name}",
            description="🔒 **SYSTEM IM LOCKDOWN**\n\n*Die Einsicht in diese Liste wurde aus Sicherheitsgründen vorübergehend gesperrt.*" if is_locked else "Die Blacklist ist aktuell leer.",
            color=DARK_RED if is_locked else DARK_GREEN,
            timestamp=datetime.now()
        )
        embed.set_footer(text=f"🛑 Zugriff verweigert | Kopierschutz-ID: #{watermark_id}")
        return [embed]

    formatted_lines = []

    for entry in real_entries:
        raw_name = entry.get("name", "").strip()
        if not raw_name:
            continue
        clean_name = re.sub(r'^[•\-\*\s]+', '', raw_name).strip()
        aliases = entry.get("aliases", [])
        note = entry.get("note")
        
        line = clean_name
        if aliases:
            line += f" ({', '.join(aliases)})"
            
        if show_notes and note:
            line += f" | Notiz: {note}"
            
        formatted_lines.append((clean_name.lower(), line))
            
    sorted_lines = sorted(formatted_lines, key=lambda x: x[0])
    grouped = {}
    for clean_lower, line in sorted_lines:
        first_char = clean_lower[0].upper() if clean_lower else "#"
        letter = first_char if first_char.isalpha() or first_char in "ÄÖÜ" else "#"
        if letter not in grouped:
            grouped[letter] = []
        grouped[letter].append(line)

    sorted_keys = sorted(grouped.keys(), key=lambda x: (x == "#", x))

    embeds = []
    chunks = []
    temp_desc = ""
    for idx, letter in enumerate(sorted_keys):
        letter_block = f"# {letter}\n"
        if not is_owner_copy and idx % 2 == 1:
            letter_block += f"*Es gefällt {watermark_id} Personen die Blacklist*\n"
        letter_block += "```\n"
        for line in grouped[letter]:
            letter_block += f"{line}\n"
        letter_block += "```\n\n"

        if len(temp_desc) + len(letter_block) > 3800:
            chunks.append(temp_desc)
            temp_desc = letter_block
        else:
            temp_desc += letter_block
    if temp_desc:
        chunks.append(temp_desc)

    total_chunks = len(chunks)

    for idx, chunk_text in enumerate(chunks):
        t_str = f"<:7990blacklistedids:1546843988328316928> {title_name}"
        if total_chunks > 1:
            t_str += f" (Teil {idx+1}/{total_chunks})"

        embed = discord.Embed(
            title=t_str,
            description="🔒 **SYSTEM IM LOCKDOWN**\n\n*Die Einsicht in diese Liste wurde aus Sicherheitsgründen vorübergehend gesperrt.*" if is_locked else chunk_text,
            color=DARK_RED if is_locked else DARK_GREEN,
            timestamp=datetime.now()
        )
        embed.set_footer(text=f"Gesamteinträge: {len(real_entries)} | 🔒 Kopierschutz-ID: #{watermark_id} (Teil {idx+1}/{total_chunks})")
        embeds.append(embed)

    return embeds

async def log_action(faction: str, embed: discord.Embed):
    channels = config.get("action_log_channels", {})
    faction_channel_id = channels.get(faction)
    if faction_channel_id:
        channel = bot.get_channel(faction_channel_id)
        if channel:
