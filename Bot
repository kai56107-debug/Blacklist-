@tasks.loop(hours=24)
async def daily_backup_task():
    global LAST_AUTO_BACKUP_TIME
    timestamp_str = datetime.now().strftime('%Y%m%d_%H%M%S')
    for faction, filename in FILES.items():
        if os.path.exists(filename):
            try:
                dest = os.path.join(BACKUP_DIR, f"backup_{faction}_{timestamp_str}.json")
                shutil.copy(filename, dest)
            except Exception as e:
                logger.error(f"Backup fehlgeschlagen für {faction}: {e}")
    LAST_AUTO_BACKUP_TIME = datetime.now().strftime("%H:%M Uhr")
    await log_system("📦 **Automatisches 24h-Backup** erfolgreich im Ordner `/backups` erstellt.")

