def build_dashboard_embed(author_name: str, author_avatar: str) -> discord.Embed:
    global PEAK_LATENCY, PREVIOUS_LATENCY
    
    current_lat = round(bot.latency * 1000, 1)
    if current_lat > PEAK_LATENCY:
        PEAK_LATENCY = current_lat
        
    trend_icon = "↘️" if current_lat < PREVIOUS_LATENCY else ("↗️" if current_lat > PREVIOUS_LATENCY else "➡️")
    PREVIOUS_LATENCY = current_lat

    uptime_seconds = int(round(time.time() - BOT_START_TIME))
    days, remainder = divmod(uptime_seconds, 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes, seconds = divmod(remainder, 60)
    uptime_str = f"{days}d {hours}h {minutes}m {seconds}s" if days > 0 else f"{hours}h {minutes}m {seconds}s"

    ram_usage_mb = 0.0
    if psutil:
        try:
            ram_usage_mb = round(psutil.Process(os.getpid()).memory_info().rss / 1024 / 1024, 1)
        except Exception:
            pass

    bound_channels = config.get("bound_messages", [])
    clean_bound_channels = []
    valid_channels_count = 0
    config_updated = False

    for item in list(bound_channels):
        ch_id = item.get("channel_id")
        channel = bot.get_channel(ch_id)
        if channel and hasattr(channel, "guild") and channel.guild:
            valid_channels_count += 1
            clean_bound_channels.append(item)
        else:
            config_updated = True

    if config_updated:
        config["bound_messages"] = clean_bound_channels
        asyncio.create_task(save_config())

    ok_jsons, total_jsons = check_database_integrity()
    db_status_str = f"🟢 {ok_jsons}/{total_jsons} JSONs OK (Schreibbar)" if ok_jsons == total_jsons else f"⚠️ {ok_jsons}/{total_jsons} JSONs lesbar"
    
    medic_count = len([e for e in blacklists['medic'] if "canary" not in e.get("name", "").lower()])
    army_count = len([e for e in blacklists['army'] if "canary" not in e.get("name", "").lower()])
    pd_count = len([e for e in blacklists['pd'] if "canary" not in e.get("name", "").lower()])
    total_active = medic_count + army_count + pd_count
    total_archived = get_total_history_count()

    last_action_ts = config.get("last_action_timestamp")
    if last_action_ts:
        diff_sec = int(round(time.time() - last_action_ts))
        a_days, a_rem = divmod(diff_sec, 86400)
        a_hours, a_rem = divmod(a_rem, 3600)
        a_mins, a_secs = divmod(a_rem, 60)
        time_ago = f"vor {a_days}d {a_hours}h" if a_days > 0 else (f"vor {a_hours}h {a_mins}m" if a_hours > 0 else (f"vor {a_mins}m" if a_mins > 0 else f"vor {a_secs}s"))
        last_action_display = f"{time_ago} ({config.get('last_action')})"
    else:
        last_action_display = config.get('last_action')

    action_logs = config.get("action_log_channels", {})
    action_config_changed = False

    def get_log_str(key):
        nonlocal action_config_changed
        cid = action_logs.get(key)
        if cid:
            ch = bot.get_channel(cid)
            if ch:
                return f"✅ Aktiv ({ch.mention})"
            else:
                action_logs[key] = None
                action_config_changed = True
                return "❌ Inaktiv (Gelöscht)"
        return "❌ Inaktiv (Fehlt)"

    med_log_str = get_log_str('medic')
    army_log_str = get_log_str('army')
    pd_log_str = get_log_str('pd')

