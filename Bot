        view = PublicBlacklistExpandView(f_type)
        
        bot_messages = []
        try:
            async for m in channel.history(limit=10):
                if m.author.id == bot.user.id and m.embeds:
                    bot_messages.append(m)
        except Exception:
            pass

        if bot_messages:
            msg = bot_messages[0]
