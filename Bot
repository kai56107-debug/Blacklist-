        inline=False
    )

    embed.add_field(
        name="📊 DATENBANK & INVENTAR",
        value=f"• <:7990blacklistedids:1546843988328316928> **Medic Blacklist:** {medic_count} Einträge\n"
              f"• <:7990blacklistedids:1546843988328316928> **Army Blacklist:** {army_count} Einträge\n"
              f"• <:7990blacklistedids:1546843988328316928> **PD Blacklist:** {pd_count} Einträge\n"
              f"• 📦 **Gesamt / Archiv:** {total_active} / {total_archived} gelöscht\n"
