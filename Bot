                await channel.send(embed=embed)
            except Exception as e:
                logger.error(f"Fehler beim Loggen für {faction}: {e}")
                
    all_channel_id = channels.get("all")
    if all_channel_id and all_channel_id != faction_channel_id:
        all_channel = bot.get_channel(all_channel_id)
        if all_channel:
            try:
                await all_channel.send(embed=embed)
            except Exception as e:
                logger.error(f"Fehler beim Loggen für Master-Log: {e}")

async def log_system(message: str, level: str = "INFO"):
    if level == "ERROR":
        logger.error(message)
        color = discord.Color.red()
        title = "🔴 System Fehler"
    elif level == "WARNING":
        logger.warning(message)
        color = discord.Color.gold()
        title = "⚠️ System Warnung"
    else:
        logger.info(message)
        color = discord.Color.blue()
        title = "ℹ️ System Information"

    channel_id = config.get("system_log_channel")
    if channel_id:
        channel = bot.get_channel(channel_id)
        if channel:
            try:
                await channel.send(embed=discord.Embed(title=title, description=message, color=color, timestamp=datetime.now()))
            except Exception as e:
                logger.error(f"Fehler beim Senden des System-Logs: {e}")

async def update_bound_messages(faction: str = None):
    if not config.get("bound_messages"):
        return
    
    clean_bound_list = []
    
    for item in list(config["bound_messages"]):
        channel_id = item.get("channel_id")
        f_type = item.get("faction")
        
        if not f_type:
            continue
            
        if faction and f_type != faction:
            clean_bound_list.append(item.copy())
            continue

        channel = bot.get_channel(channel_id)
        if not channel:
            continue

        is_locked = config.get("lockdown", False)
        faction_names = {"medic": "Mediziner Lomita Blacklist", "army": "Army Blacklist", "pd": "PD Blacklist"}
        title_name = faction_names.get(f_type, "Blacklist")

        closed_embed = discord.Embed(
            title=f"<:7990blacklistedids:1546843988328316928> {title_name}",
            description="🔒 **SYSTEM IM LOCKDOWN**\n\n*Die Einsicht in diese Liste wurde aus Sicherheitsgründen vorübergehend gesperrt.*" if is_locked else "Klicke auf den Button unten, um die aktuelle Blacklist für **30 Sekunden** für alle sichtbar im Kanal zu öffnen.\n\n*Bei jedem Aufruf wird ein neuer, eindeutiger Sicherheitscode generiert.*",
            color=DARK_RED if is_locked else DARK_GREEN,
            timestamp=datetime.now()
        )
        closed_embed.set_footer(text="🔒 Gesichertes Abrufsystem | Schließt automatisch nach 30 Sekunden")

        view = PublicBlacklistExpandView(f_type)
        
        bot_messages = []
        try:
            async for m in channel.history(limit=10):
                if m.author.id == bot.user.id and m.embeds:
                    bot_messages.append(m)
        except Exception:
            pass

        if bot_messages:
            msg = bot_messages[0]
            try:
                await msg.edit(embed=closed_embed, view=view)
                item["message_ids"] = [msg.id]
            except Exception:
                msg = await channel.send(embed=closed_embed, view=view)
                item["message_ids"] = [msg.id]
        else:
            msg = await channel.send(embed=closed_embed, view=view)
            item["message_ids"] = [msg.id]

        clean_bound_list.append(item)

    config["bound_messages"] = clean_bound_list
    await save_config()

