        inline=False
    )

    embed.add_field(
        name="⚙️ MONITORING & KANÄLE",
        value=f"```text\n"
              f"┌ 📺 Live-Embeds     : {valid_channels_count}/{len(bound_channels)} Bereit ✅\n"
              f"├ 🔍 Namens-Filter   : {len(keywords)} Keywords\n"
