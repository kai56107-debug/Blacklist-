        await interaction.followup.send(f"❌ Du hast keine Rechte als **{faction.upper()}**-Admin!", ephemeral=True)
        return

    u_id = interaction.user.id
    now = time.time()
    
    if u_id not in removal_attempts:
        removal_attempts[u_id] = []
    
    removal_attempts[u_id] = [t for t in removal_attempts[u_id] if now - t < 60]
    removal_attempts[u_id].append(now)

    if len(removal_attempts[u_id]) >= 3:
        config["lockdown"] = True
        await save_config()
        await update_bound_messages()
        
        alarm_msg = (
            f"🚨 **AUTOMATISCHER LOCKDOWN (Massen-Löschversuch!):**\n"
            f"• **Admin:** {interaction.user.mention} (`{interaction.user.name}` | ID: `{u_id}`)\n"
            f"• **Grund:** 3 Lösch-Anfragen innerhalb von 60 Sekunden.\n"
            f"• **Aktion:** Das System wurde sofort gesperrt."
        )
