@bot.tree.command(name="alias", description="Fügt einem Eintrag einen Alias hinzu.")
@app_commands.describe(faction="Wähle die Fraktion", target_name="Aktueller Hauptname", alias_name="Neuer Alias")
@app_commands.choices(faction=[
    app_commands.Choice(name="Mediziner", value="medic"),
    app_commands.Choice(name="Army", value="army"),
    app_commands.Choice(name="Police Department", value="pd")
])
async def slash_alias(interaction: discord.Interaction, faction: str, target_name: str, alias_name: str):
    if config.get("lockdown", False):
        await trigger_silent_alarm(interaction, "alias")
        await interaction.response.send_message("🔒 **System Lockdown:** Das Hinzufügen von Aliases ist gesperrt.", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)
    if not check_faction_permission(interaction.user, faction):
        await interaction.followup.send(f"❌ Du hast keine Rechte als **{faction.upper()}**-Admin!", ephemeral=True)
        return

    cleaned_alias, _, err = validate_and_clean_name(alias_name)
    if err:
        await interaction.followup.send(f"❌ Ungültiger Alias: {err}", ephemeral=True)
        return

    entries = blacklists[faction]
    alias_lower = cleaned_alias.lower()
    for entry in entries:
        if entry.get("name", "").lower() == alias_lower or alias_lower in [a.lower() for a in entry.get("aliases", [])]:
            await interaction.followup.send(f"⚠️ Der Name/Alias **{cleaned_alias}** existiert bereits in dieser Blacklist!", ephemeral=True)
            return

    target_entry = next((e for e in entries if e.get("name", "").lower() == target_name.strip().lower()), None)
    if not target_entry:
        await interaction.followup.send(f"⚠️ Hauptname **{target_name}** nicht gefunden.", ephemeral=True)
        return

    if "aliases" not in target_entry:
        target_entry["aliases"] = []

    target_entry["aliases"].append(cleaned_alias)
    await save_data(faction)
    await update_bound_messages(faction)

    config["last_action"] = f"🏷️ Alias `{cleaned_alias}` für `{target_entry['name']}` ({faction.upper()})"
    config["last_action_timestamp"] = time.time()
    await save_config()

    await interaction.followup.send(f"✅ Alias **{cleaned_alias}** zu **{target_entry['name']}** hinzugefügt.", ephemeral=True)
    await log_system(f"ℹ️ **Alias hinzugefügt** für `{target_entry['name']}` ({faction.upper()}): `{cleaned_alias}`")

