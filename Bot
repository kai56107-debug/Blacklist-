        await interaction.followup.send("🚨 **Sicherheits-Alarm:** Zu viele Lösch-Anfragen in kurzer Zeit. System im Lockdown!", ephemeral=True)
        return

    cleaned, _, _ = validate_and_clean_name(name)
    target_name = (cleaned if cleaned else name.strip()).lower()
    
    entries = blacklists[faction]
    entry_to_remove = next((e for e in entries if e.get("name", "").lower() == target_name or target_name in [a.lower() for a in e.get("aliases", [])]), None)
    
    if not entry_to_remove:
        await interaction.followup.send(f"⚠️ **{name}** nicht gefunden.", ephemeral=True)
        return

    req_id = str(time.time())
    view = RemoveApprovalView(req_id, faction, entry_to_remove, interaction.user.id)
    
