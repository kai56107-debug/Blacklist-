class BulkAddModal(discord.ui.Modal):
    def __init__(self, faction: str):
        faction_titles = {
            "medic": "Mediziner",
            "army": "Army",
            "pd": "Police Department (PD)"
        }
        super().__init__(title=f"Mehrere Einträge hinzufügen ({faction_titles.get(faction, faction.upper())})")
        self.faction = faction

    names_input = discord.ui.TextInput(
        label="Namen (jeweils ein Name pro Zeile)",
        style=discord.TextStyle.paragraph,
        placeholder="Max Mustermann\nErika Mustermann\nJohn Doe",
        required=True,
        max_length=2000
    )

    async def on_submit(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        
        if config.get("lockdown", False) and interaction.user.id != OWNER_ID:
            await interaction.followup.send("🔒 **System Lockdown:** Das Hinzufügen ist gesperrt.", ephemeral=True)
            return

        if not check_faction_permission(interaction.user, self.faction):
            await interaction.followup.send(f"❌ Keine Rechte für diese Fraktion!", ephemeral=True)
            return

        raw_lines = self.names_input.value.splitlines()
        added_count = 0
        skipped_count = 0
        entries = blacklists[self.faction]

        for line in raw_lines:
            line_str = line.strip()
            if not line_str:
                continue
            
            cleaned, note, err = validate_and_clean_name(line_str)
            if err or not cleaned:
                skipped_count += 1
                continue

            if any(e.get("name", "").lower() == cleaned.lower() for e in entries):
                skipped_count += 1
                continue

            new_entry = {"name": cleaned, "aliases": [], "note": note}
            entries.append(new_entry)
            added_count += 1

        faction_display_names = {"medic": "Mediziner", "army": "Army", "pd": "Police Department (PD)"}
        f_name = faction_display_names.get(self.faction, self.faction.upper())

        if added_count > 0:
            await save_data(self.faction)
            await update_bound_messages(self.faction)
            config["last_action"] = f"➕ Massen-Add ({added_count}) zu {f_name} ({interaction.user.display_name})"
            config["last_action_timestamp"] = time.time()
            await save_config()

            action_embed = discord.Embed(
                title=f"➕ [{f_name}] Massen-Hinzufügen",
                description=f"Es wurden **{added_count}** Spieler erfolgreich hinzugefügt. (Übersprungen: {skipped_count})",
                color=BRIGHT_GREEN,
                timestamp=datetime.now()
            )
            action_embed.add_field(name="Von", value=interaction.user.mention, inline=False)
            await log_action(self.faction, action_embed)

        await interaction.followup.send(f"✅ **{added_count}** Namen zu **{f_name}** hinzugefügt, `{skipped_count}` übersprungen.", ephemeral=True)

