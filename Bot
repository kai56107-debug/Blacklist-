    async def close_list(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.defer()
        await self.reset_to_closed(interaction.message)

    async def on_timeout(self):
        try:
            for item in config.get("bound_messages", []):
                if self.message_id in item.get("message_ids", []):
                    channel_id = item.get("channel_id")
                    channel = bot.get_channel(channel_id)
                    if channel:
                        msg = await channel.fetch_message(self.message_id)
                        await self.reset_to_closed(msg)
                    break
