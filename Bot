    else:
        embed_color = BRIGHT_GREEN
        overall_status = "🟢 OPTIMAL"

    backup_time_str = f"✅ Heute ({LAST_AUTO_BACKUP_TIME})" if LAST_AUTO_BACKUP_TIME else "✅ Aktiv (In Kürze)"

    embed = discord.Embed(
        title="🏓 SYSTEM CONTROL PANEL",
        description=f"**STATUS:** `{overall_status}` | **LOCKDOWN:** `{'🔴 AKTIV' if is_locked else '🟢 NORMAL'}`",
        color=embed_color,
        timestamp=datetime.now()
    )

    embed.add_field(
        name="⚡ LEISTUNG & NETZWERK",
        value=f"```text\n"
              f"┌ 📶 API-Latenz    : {current_lat} ms {trend_icon} (Peak: {PEAK_LATENCY} ms)\n"
              f"├ 🌐 Gateway/WS    : 100% OK (🟢 Heartbeat aktiv)\n"
